<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#07111f">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📸"
        android:textSize="64sp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BLS Visa"
        android:textSize="28sp"
        android:textColor="#f5d27a"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Première connexion"
        android:textSize="14sp"
        android:textColor="#888888"
        android:layout_marginBottom="48dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Entrez votre numéro de téléphone"
        android:textSize="14sp"
        android:textColor="#cccccc"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/et_phone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="+213XXXXXXXXX"
        android:inputType="phone"
        android:textColor="#ffffff"
        android:textColorHint="#555555"
        android:backgroundTint="#1a2a3a"
        android:padding="16dp"
        android:textSize="20sp"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btn_register"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="S'enregistrer"
        android:textSize="16sp"
        android:backgroundTint="#10ac84"
        android:textColor="#ffffff"
        android:layout_marginBottom="20dp"/>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#aaaaaa"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4"/>

</LinearLayout>
